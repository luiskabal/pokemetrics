{
  "name": "pokemetrics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "update:locales": "node scripts/update-locales.mjs",
    "update:generations": "node scripts/update-generations.mjs",
    "update:data": "node scripts/update-data.mjs",
    "update:media": "python scripts/update-media.py"
  },
  "dependencies": { "svelte": "5.57.3" },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.0.0",
    "daisyui": "5.7.50",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
